{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Minimap Nudge",
  "version": "2.4.0",
  "identifier": "com.thomas.minimapnudge",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; script-src 'self'; style-src 'self'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "publisher": "Thomas",
    "shortDescription": "Minimap reminder for League of Legends",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDhDNTBEQTM4OTE2NTRBNUUKUldSZVNtV1JPTnBRak1OQ3NiMkd0Yk52RUtZWkhDZXF4S3NVTHoxcDBpY0tPYWxRNld0dGVTMVEK",
      "endpoints": [
        "https://github.com/TohmKench/minimap-nudge/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
